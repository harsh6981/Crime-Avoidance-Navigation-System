# SafePath Frontend Environment Variables
# Copy this file to .env and configure your values.

# ── Base API Endpoints ──
# Main Python FastAPI backend (routing, weather, hazards, trips, resources)
# For local Android testing, replace localhost with your PC's LAN IP (e.g. http://192.168.1.50:8000)
VITE_API_URL=http://localhost:8000

# Express/Node.js authentication backend (login, registration, Google auth)
# For local Android testing, replace localhost with your PC's LAN IP (e.g. http://192.168.1.50:5000)
VITE_AUTH_URL=http://localhost:5000

# ── Map & Geolocation API Keys ──
# CARTO basemap API key (optional for Voyager basemap)
VITE_CARTO_API_KEY=

# TomTom API key (traffic flow tiles, raster basemap, fuzzy search & geocoding)
VITE_TOMTOM_API_KEY=

# Optional Google Maps API key
VITE_GOOGLE_MAPS_API_KEY=

# ── Firebase Authentication (Optional for Google Sign-In) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

